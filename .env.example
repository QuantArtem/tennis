# Токен бота от @BotFather. Без него сервер работает в ДЕМО-режиме (без проверки Telegram) — только для локальной разработки!
BOT_TOKEN=

# Ключ для API клуба (заголовок X-API-Key). Пусто = API клуба выключен.
# Сгенерировать: openssl rand -hex 32
CLUB_API_KEY=

# Ссылка на мини-апп (нужна для кнопки «Поделиться»), например https://t.me/my_tennis_bot/play
APP_LINK=

CLUB_NAME=Теннисный клуб
# Часовой пояс клуба — все времена игр указываются в нём
CLUB_TZ=Europe/Moscow

PORT=3000
DB_PATH=./data/tennis.db
